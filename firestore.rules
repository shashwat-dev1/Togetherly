rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function couplePath(id) {
      return /databases/$(database)/documents/couples/$(id);
    }

    function invitationPath(id) {
      return /databases/$(database)/documents/invitations/$(id);
    }

    function validCode(id) {
      return id is string && id.matches('^[A-HJ-NP-Z2-9]{26}$');
    }

    function unpaired(profile) {
      return profile.get('activeCoupleId', null) == null;
    }

    function canRedeem(invite) {
      return invite.status == 'pending' && invite.createdBy != request.auth.uid &&
        invite.expiresAt is timestamp && request.time < invite.expiresAt;
    }

    function pairingProfileUpdate(uid) {
      let id = request.resource.data.activeCoupleId;
      return validCode(id) && unpaired(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCoupleId', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        !exists(couplePath(id)) &&
        getAfter(couplePath(id)).data.memberIds[1] == request.auth.uid &&
        uid in getAfter(couplePath(id)).data.memberIds;
    }

    function validPairCreation(id) {
      let couple = request.resource.data;
      let invite = get(invitationPath(id)).data;
      let accepted = getAfter(invitationPath(id)).data;
      let creator = invite.createdBy;
      let recipient = request.auth.uid;
      return canRedeem(invite) &&
        accepted.status == 'accepted' && accepted.claimedBy == recipient &&
        couple.id == id && couple.createdBy == creator && couple.status == 'active' &&
        couple.createdAt == request.time &&
        couple.memberIds == [creator, recipient] &&
        couple.members.keys().hasOnly([creator, recipient]) &&
        couple.members.keys().hasAll([creator, recipient]) &&
        unpaired(get(userPath(creator)).data) && unpaired(get(userPath(recipient)).data) &&
        getAfter(userPath(creator)).data.activeCoupleId == id &&
        getAfter(userPath(recipient)).data.activeCoupleId == id;
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && unpaired(request.resource.data);
      allow update: if (isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeCoupleId'])) ||
        (isAuthenticated() && pairingProfileUpdate(uid));
      allow delete: if isOwner(uid) && unpaired(resource.data);
    }

    // 2. Couples Collection
    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if isAuthenticated() && validCode(coupleId) && validPairCreation(coupleId);
      allow update: if isCoupleMember(coupleId) &&
        // Prevent clients from altering couple ownership or member identities
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'memberIds', 'createdBy', 'createdAt', 'status']) &&
        request.resource.data.members.keys().hasOnly(resource.data.memberIds);
      allow delete: if false; // Requires explicit account deletion workflow

      // Private Data Subcollection (Drafts, notes, unrevealed answers)
      match /privateData/{uid} {
        allow read, write: if isOwner(uid) && isCoupleMember(coupleId);
      }

      match /gameLobbies/{gameId} {
        allow get: if isCoupleMember(coupleId);
        allow create, update: if gameId == 'last-heart' && isCoupleMember(coupleId) &&
          request.resource.data.keys().hasOnly(['sessionId']) &&
          request.resource.data.sessionId is string &&
          validLobbyTarget(request.resource.data.sessionId, coupleId, gameId);
      }

      match /togetherDates/{dateId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId) &&
          dateId in ['anniversary', 'firstMeet', 'firstDate', 'engagement', 'memory'] &&
          request.resource.data.keys().hasOnly(['date']) &&
          request.resource.data.date is string &&
          request.resource.data.date.matches('^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$');
        allow delete: if isCoupleMember(coupleId);
      }

      // Daily Challenge Progress
      match /dailyChallengeProgress/{date} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Achievements Subcollection
      match /achievements/{achievementId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Activities Timeline Subcollection
      match /activities/{activityId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update, delete: if false;
      }

      // XP Transactions Subcollection (Couples audit trail)
      match /xpTransactions/{txId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId);
        allow update, delete: if false;
      }
    }

    // 3. Invitations Collection
    match /invitations/{invitationId} {
      allow list: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow get: if isAuthenticated() && (
        (resource != null && resource.data.createdBy == request.auth.uid) ||
        (validCode(invitationId) && (resource == null || canRedeem(resource.data)))
      );
      allow create: if isAuthenticated() && validCode(invitationId) &&
        request.resource.data.keys().hasOnly([
          'id', 'code', 'createdBy', 'creatorName', 'creatorAvatarId', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.id == invitationId && request.resource.data.code == invitationId &&
        request.resource.data.createdBy == request.auth.uid &&
        unpaired(get(userPath(request.auth.uid)).data) &&
        request.resource.data.creatorName is string && request.resource.data.creatorName.size() <= 200 &&
        request.resource.data.creatorAvatarId is string && request.resource.data.creatorAvatarId.size() <= 100 &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp && request.time < request.resource.data.expiresAt &&
        request.resource.data.expiresAt <= request.time + duration.value(49, 'h');
      allow update: if isAuthenticated() && resource.data.status == 'pending' && (
        (resource.data.createdBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']) &&
          request.resource.data.status == 'cancelled' && request.resource.data.cancelledAt == request.time) ||
        (validCode(invitationId) && canRedeem(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt']) &&
          request.resource.data.status == 'accepted' && request.resource.data.claimedBy == request.auth.uid &&
          request.resource.data.claimedAt == request.time &&
          !exists(couplePath(invitationId)) &&
          getAfter(couplePath(invitationId)).data.memberIds == [resource.data.createdBy, request.auth.uid])
      );
    }

    function validLobbyTarget(id, coupleId, gameId) {
      let lobby = getAfter(/databases/$(database)/documents/gameSessions/$(id)).data;
      return lobby.coupleId == coupleId && lobby.gameId == gameId && lobby.status == 'waiting';
    }

    function validGamePlayers(game) {
      let members = get(couplePath(game.coupleId)).data.memberIds;
      return game.playerIds is list && game.playerIds.size() == 2 &&
        game.playerIds[0] != game.playerIds[1] &&
        game.playerIds.hasOnly(members) && request.auth.uid in game.playerIds;
    }

    function validLastHeartStart(game, sessionId) {
      return game.gameMode == 'turn_based' && game.status == 'waiting' && game.winnerId == null &&
        game.currentTurn == request.auth.uid && game.playerIds[0] == request.auth.uid &&
        game.readyPlayers == [request.auth.uid] &&
        game.gameState == {'remaining': 15, 'turnNumber': 0, 'round': 1, 'maxRounds': 5} &&
        game.scores.keys().hasOnly(game.playerIds) &&
        game.scores[game.playerIds[0]] == 0 && game.scores[game.playerIds[1]] == 0 &&
        game.xpAwarded == 0 &&
        getAfter(/databases/$(database)/documents/couples/$(game.coupleId)/gameLobbies/last-heart).data.sessionId == sessionId;
    }

    function validLastHeartMove(before, after, changed) {
      let uid = request.auth.uid;
      let other = before.playerIds[0] == uid ? before.playerIds[1] : before.playerIds[0];
      let remaining = after.gameState.remaining;
      let taken = before.gameState.remaining - remaining;
      return before.status == 'active' && before.currentTurn == uid &&
        remaining is int && remaining >= 0 && taken >= 1 && taken <= 3 &&
        after.gameState.turnNumber == before.gameState.turnNumber + 1 &&
        after.gameState.diff(before.gameState).affectedKeys().hasOnly(['remaining', 'turnNumber']) &&
        changed.hasOnly(['gameState', 'scores', 'currentTurn', 'winnerId', 'status', 'xpAwarded', 'updatedAt']) &&
        after.scores.diff(before.scores).affectedKeys().hasOnly([uid]) &&
        ((remaining == 0 && after.status == 'completed' && after.winnerId == uid &&
          after.currentTurn == uid && after.scores[uid] == 1 && after.xpAwarded == 30) ||
         (remaining > 0 && after.status == 'active' && after.winnerId == null &&
          after.currentTurn == other && after.scores[uid] == 0 && after.xpAwarded == 0));
    }

    function validLastHeartUpdate(before, after) {
      let changed = after.diff(before).affectedKeys();
      return after.updatedAt == request.time && (
        (before.status == 'waiting' && after.status == 'active' &&
          request.auth.uid != before.playerIds[0] && after.readyPlayers == before.playerIds &&
          changed.hasOnly(['readyPlayers', 'status', 'updatedAt'])) ||
        (before.status in ['waiting', 'active'] && after.status == 'abandoned' &&
          after.abandonedBy == request.auth.uid && changed.hasOnly(['status', 'abandonedBy', 'updatedAt'])) ||
        (before.status == 'completed' && after.rematchRequestedBy == request.auth.uid &&
          changed.hasOnly(['rematchSessionId', 'rematchRequestedBy', 'updatedAt'])) ||
        validLastHeartMove(before, after, changed)
      );
    }

    // 4. Game Sessions Collection
    match /gameSessions/{sessionId} {
      allow get: if isAuthenticated() && request.auth.uid in resource.data.playerIds;
      allow list: if isAuthenticated() && isCoupleMember(resource.data.coupleId);
      allow create: if isAuthenticated() && validGamePlayers(request.resource.data) &&
        (request.resource.data.gameId != 'last-heart' || validLastHeartStart(request.resource.data, sessionId));

      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.playerIds &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'playerIds', 'coupleId', 'createdBy', 'gameId', 'gameMode']) &&
        (resource.data.gameId != 'last-heart' || validLastHeartUpdate(resource.data, request.resource.data));

      // 4.1 Private Answers Subcollection (Double-Blind Secret Architecture for Spark)
      // Strictly denies the partner from reading answers before they have submitted their own answer for this round!
      match /privateAnswers/{answerId} {
        allow read: if isAuthenticated() && (
          // Caller can always read their own submission
          resource.data.playerId == request.auth.uid ||
          // Partner can read caller's submission ONLY IF the partner has already submitted their own answer for this round!
          (
            request.auth.uid in get(/databases/$(database)/documents/gameSessions/$(sessionId)).data.playerIds &&
            exists(/databases/$(database)/documents/gameSessions/$(sessionId)/privateAnswers/$(request.auth.uid + '_r' + resource.data.round))
          )
        );
        allow create, update: if isAuthenticated() && 
          request.resource.data.playerId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/gameSessions/$(sessionId)).data.playerIds;
        allow delete: if false;
      }

      // 4.2 Actions Log Subcollection (Append-Only)
      match /actions/{actionId} {
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/gameSessions/$(sessionId)).data.playerIds;
        allow create: if isAuthenticated() && 
          request.resource.data.playerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 5. XP Transactions Collection (Top-Level Immutable Audit Trail)
    match /xpTransactions/{transactionId} {
      allow read: if isAuthenticated() && isCoupleMember(resource.data.coupleId);
      allow create: if isAuthenticated() && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if false;
    }

    // 6. Notifications Collection
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    // 7. Pilot Feedback Collection (Protected - Admin & Author Access Only)
    match /pilotFeedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
