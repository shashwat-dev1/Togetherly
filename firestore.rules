rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function isSessionPlayer(sessionData) {
      return isAuthenticated() && request.auth.uid in sessionData.playerIds;
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // 2. Couples Collection
    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      // Client can only create new couple or update non-sensitive metadata
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberIds;
      allow update: if isCoupleMember(coupleId) &&
        // Prevent clients from directly editing sharedXP or coupleLevel
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedXP', 'coupleLevel']);
      allow delete: if false; // Requires explicit account deletion workflow

      // Private Data Subcollection (Drafts, notes, unrevealed answers)
      match /privateData/{uid} {
        allow read, write: if isOwner(uid);
      }

      // Daily Challenge Progress
      match /dailyChallengeProgress/{date} {
        allow read: if isCoupleMember(coupleId);
        allow write: if isCoupleMember(coupleId);
      }

      // Achievements
      match /achievements/{achievementId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false; // Cloud Functions authority only
      }
    }

    // 3. Invitations Collection
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAuthenticated() &&
        // Can only claim if pending, not expired, and cannot claim own invite
        resource.data.status == 'pending' &&
        resource.data.createdBy != request.auth.uid &&
        request.time < resource.data.expiresAt;
    }

    // 4. Game Sessions Collection
    match /gameSessions/{sessionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.playerIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.playerIds;
      
      // Updates require player membership; score and winner manipulations blocked
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.playerIds &&
        // Clients cannot self-declare scores, winners, or XP rewards
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['scores', 'winnerId', 'xpAwarded']);

      // 4.1 Private Answers Subcollection (Double-Blind Secret Architecture)
      // Strictly denies the partner from reading answers before the server reveal!
      match /privateAnswers/{answerId} {
        allow read: if isAuthenticated() && resource.data.playerId == request.auth.uid;
        allow create, update: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
        allow delete: if false;
      }

      // 4.2 Actions Log Subcollection (Append-Only)
      match /actions/{actionId} {
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/gameSessions/$(sessionId)).data.playerIds;
        allow create: if isAuthenticated() && 
          request.resource.data.playerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 5. XP Transactions Collection (Immutable Audit Trail)
    match /xpTransactions/{transactionId} {
      allow read: if isAuthenticated() && isCoupleMember(resource.data.coupleId);
      allow write: if false; // Only Cloud Functions (Admin SDK) can create XP transactions
    }

    // 6. Notifications Collection
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }
  }
}
