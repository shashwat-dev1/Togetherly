# TOGETHERLY — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.

# Runtime Mode: 'production' | 'emulator' | 'mock'
# If left unset:
# - Uses 'production' if API keys are provided below
# - Defaults to 'mock' for local preview and unit testing
EXPO_PUBLIC_FIREBASE_MODE=mock

# Firebase Emulator Host (if using 'emulator' mode)
# For Android Studio Emulator use: 10.0.2.2
# For Physical Android device on Wi-Fi use your machine's LAN IP, e.g.: 192.168.1.50
# For Web / iOS Simulator use: 127.0.0.1
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Production Firebase Web / Mobile SDK Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=togetherly-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=togetherly-couples
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=togetherly-couples.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef123456

# Google AdMob Configuration
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# RevenueCat / Google Play Billing
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_sample_key_here
