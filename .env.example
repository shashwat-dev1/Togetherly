# TOGETHERLY — ENVIRONMENT CONFIGURATION (.env)
# ====================================================================
# Instructions:
# 1. Copy this template: cp .env.example .env
# 2. Fill in your dedicated Firebase project credentials from the Firebase Console:
#    Project Settings -> General -> Your apps -> Web app / Android app
# 3. For the Closed Pilot Build, set EXPO_PUBLIC_FIREBASE_MODE=production
# 4. NEVER commit the real .env file or credentials to Git!
# ====================================================================

# Runtime Mode: 'production' | 'emulator' | 'mock'
# - 'production': Connects to live Firebase Cloud (REQUIRED FOR PILOT APK)
# - 'emulator': Connects to local Firebase Emulator Suite
# - 'mock': In-memory developer simulation for offline development
EXPO_PUBLIC_FIREBASE_MODE=production
EXPO_PUBLIC_APP_ENV=pilot

# Firebase Emulator Host (Only used if EXPO_PUBLIC_FIREBASE_MODE=emulator)
# - For Android Studio Emulator use: 10.0.2.2
# - For Physical Android device on same Wi-Fi use machine LAN IP, e.g.: 192.168.1.50
# - For Web / iOS Simulator use: 127.0.0.1
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# ====================================================================
# LIVE FIREBASE CONFIGURATION (Project: togetherly-17397)
# ====================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=togetherly-17397.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=togetherly-17397
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=togetherly-17397.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=989877180170
EXPO_PUBLIC_FIREBASE_APP_ID=1:989877180170:web:YOUR_WEB_APP_ID

# Optional: Dedicated Pilot Feedback & Error Telemetry
EXPO_PUBLIC_PILOT_COHORT_ID=pilot_nov2026
